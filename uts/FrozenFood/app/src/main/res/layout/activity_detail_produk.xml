<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKembaliDetail"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_category"
                android:gravity="center"
                android:text="‹"
                android:textColor="#202820"
                android:textSize="32sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Detail Produk"
                android:textColor="#202820"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="♡"
                android:textColor="#16834A"
                android:textSize="26sp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_product_image">

            <ImageView
                android:id="@+id/imgDetailProduk"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Detail Produk"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@drawable/nugget" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvKategoriProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_category"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Frozen Food"
            android:textColor="#120E0E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nugget Ayam"
            android:textColor="#202820"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHargaProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Rp25.000"
            android:textColor="#120E0E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Deskripsi Produk"
            android:textColor="#202820"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeskripsiProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Nugget ayam dengan rasa gurih dan tekstur renyah. Cocok untuk lauk makan atau camilan bersama keluarga. Simpan dalam freezer agar kualitas produk tetap terjaga."
            android:textColor="#777F78"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stok Produk"
                android:textColor="#202820"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStokProduk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tersedia"
                android:textColor="#120E0E"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E5E9E3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Jumlah Produk"
            android:textColor="#202820"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKurang"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_category"
                android:gravity="center"
                android:text="−"
                android:textColor="#120E0E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJumlah"
                android:layout_width="55dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#202820"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTambah"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_category"
                android:gravity="center"
                android:text="+"
                android:textColor="#120E0E"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnTambahKeranjang"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="#16834A"
            android:text="Tambah ke Keranjang"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBeliSekarang"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#12663A"
            android:text="Beli Sekarang"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>